<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Framework-dependent: requires .NET 10 runtime on the target machine.      -->
    <!-- Keeps the published exe small (app code only, no bundled runtime).         -->
    <!-- To produce a fully standalone 150MB exe instead, publish with:             -->
    <!--   dotnet publish -c Release -p:SelfContained=true                          -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Ensure that after publish, the single-file bundle is also copied to $(OutputPath) -->
  <!-- so copying LastLapCalc.exe directly from bin\Release gives the portable bundle.   -->
  <Target Name="CopyPublishExeToOutputPath" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(TargetName).exe" DestinationFolder="$(OutputPath)" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
